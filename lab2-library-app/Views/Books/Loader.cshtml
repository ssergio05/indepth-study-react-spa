@{
    ViewData["Title"] = "Book Loader";
}

<div class="container mt-5">
    <h2>Book Loader</h2>
    <p class="text-muted">Upload a CSV file to import books in bulk. The format should be: <code>Title,Author,GenreId</code></p>
    
    <div class="card p-4 shadow-sm border-0 bg-light" style="max-width: 500px;">
        <form asp-action="Loader" enctype="multipart/form-data" method="post">
            <div class="mb-4">
                <label for="file" class="form-label fw-bold">Select CSV File</label>
                <input type="file" name="file" class="form-control" accept=".csv" required />
            </div>
            <button type="submit" class="btn btn-primary px-4">Import Books</button>
            <a asp-action="Index" class="btn btn-outline-secondary ms-2">Cancel</a>
        </form>
    </div>
</div>